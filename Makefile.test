# Standalone test build for the FreeSWITCH-free units (SDP answer
# parser, metadata builder, G.711 tables, string builder, URI check),
# unit-tested independently of the module build.
#
# Usage:
#   make -f Makefile.test test          strict-warnings build + run
#   make -f Makefile.test fscheck FS_SRC=/path/to/freeswitch
#                                       compile the FS-dependent files
#                                       against a FreeSWITCH source tree
#   make -f Makefile.test lint          cppcheck --enable=all
#   make -f Makefile.test asan          ASan + UBSan + LSan
#   make -f Makefile.test coverage      gcov line coverage of the units
#   make -f Makefile.test analyzer      gcc -fanalyzer
#   make -f Makefile.test tidy          clang-tidy
#   make -f Makefile.test all-checks    every layer above
#   make -f Makefile.test clean

CC      ?= gcc
CFLAGS  ?= -Wall -Wextra -Wpedantic -Werror -O2 -g -std=c11
TEST    = siprec_test
SOURCES = siprec_test.c siprec_sdp.c siprec_metadata.c siprec_g711.c siprec_sb.c \
          siprec_uri.c

# Sanitizer flags. -O1 keeps reports readable;
# -fno-omit-frame-pointer gets accurate stacks. Do NOT combine
# with -fsanitize=thread in the same build — ASan and TSan are
# mutually exclusive.
SAN_CFLAGS  = -O1 -g -std=c11 -Wall -Wextra -Wpedantic \
              -fsanitize=address,undefined -fno-omit-frame-pointer
SAN_LDFLAGS = -fsanitize=address,undefined

# Halt-on-error means a sanitizer report fails the build
# rather than passing through with diagnostics.
SAN_RUN_ENV = UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 \
              ASAN_OPTIONS=detect_leaks=1:halt_on_error=1

# Coverage build. -O0 keeps line<->statement mapping faithful so
# gcov's per-line counts aren't smeared by optimisation. We only
# report the units actually under test (the FS-free builders),
# NOT the harness driver siprec_test.c itself.
COV_CFLAGS = -O0 -g -std=c11 --coverage
COV_UNITS  = siprec_sdp.c siprec_metadata.c siprec_g711.c siprec_sb.c siprec_uri.c

.PHONY: test fscheck lint asan analyzer tidy coverage all-checks clean

test: $(TEST)
	./$(TEST)

$(TEST): $(SOURCES) siprec_sdp.h siprec_metadata.h siprec_g711.h siprec_sb.h siprec_uri.h
	$(CC) $(CFLAGS) $(SOURCES) -o $@

# Compile (syntax + -Wall -Wextra -Werror) the four FreeSWITCH-dependent
# translation units against an unconfigured FreeSWITCH source tree. Only
# switch_am_config.h is generated by ./configure, and nothing here needs
# its contents, so an empty stand-in is enough. cppcheck (lint) cannot
# see FreeSWITCH's headers, so this is the real type check for these
# files short of the Docker load gate (tests/load/).
FS_SRC     ?= $(HOME)/src/freeswitch
FS_FILES    = mod_siprec.c recording_session.c siprec_invite.c siprec_media.c
FS_STUB_DIR = .fscheck-inc

fscheck:
	@test -f $(FS_SRC)/src/include/switch.h || \
	    { echo "FS_SRC=$(FS_SRC) is not a FreeSWITCH source tree"; exit 1; }
	@mkdir -p $(FS_STUB_DIR) && : > $(FS_STUB_DIR)/switch_am_config.h
	@for f in $(FS_FILES); do \
	    $(CC) -std=gnu11 -fsyntax-only -Wall -Wextra -Wno-unused-parameter -Werror \
	        -I$(FS_STUB_DIR) -I$(FS_SRC)/src/include \
	        -I$(FS_SRC)/libs/libteletone/src -I. $$f || exit 1; \
	done; echo "fscheck: $(FS_FILES) compile clean"
	@rm -rf $(FS_STUB_DIR)

lint:
	cppcheck --enable=all --inline-suppr --check-level=exhaustive \
	    --suppress=missingIncludeSystem --suppress=missingInclude \
	    --suppress=unusedFunction --suppress=staticFunction \
	    --suppress=checkersReport --suppress=unmatchedSuppression \
	    --suppress=normalCheckLevelMaxBranches \
	    --error-exitcode=1 --std=c11 --force -I . \
	    siprec_sdp.c siprec_metadata.c siprec_test.c \
	    siprec_g711.c siprec_sb.c siprec_uri.c siprec_invite.c siprec_media.c \
	    mod_siprec.c recording_session.c

# AddressSanitizer + UBSan + LeakSanitizer (LSan runs at exit
# under ASan). Catches heap/stack/global out-of-bounds,
# use-after-free, double-free, leaks, integer overflow, etc.
asan:
	rm -f $(TEST)
	$(CC) $(SAN_CFLAGS) $(SOURCES) $(SAN_LDFLAGS) -o $(TEST)
	$(SAN_RUN_ENV) ./$(TEST)

# gcc -fanalyzer is a flow-sensitive checker that finds
# null-deref, leak, and use-after-free across a wider call
# graph than cppcheck's pattern matching.
analyzer:
	$(CC) -fanalyzer -Wall -Wextra -std=c11 -c siprec_sdp.c -o /dev/null
	$(CC) -fanalyzer -Wall -Wextra -std=c11 -c siprec_metadata.c -o /dev/null
	$(CC) -fanalyzer -Wall -Wextra -std=c11 -c siprec_g711.c -o /dev/null
	$(CC) -fanalyzer -Wall -Wextra -std=c11 -c siprec_sb.c -o /dev/null
	$(CC) -fanalyzer -Wall -Wextra -std=c11 -c siprec_uri.c -o /dev/null
	$(CC) -fanalyzer -Wall -Wextra -std=c11 -c siprec_test.c -o /dev/null

# clang-tidy with default checks minus the C11 Annex K buffer
# checker (clang-analyzer-security.insecureAPI.Deprecated...),
# which demands the _s functions glibc doesn't implement and is
# therefore unsatisfiable here. It is disabled project-wide in
# .clang-tidy; the flagged libc-call sites keep per-call
# rationale comments explaining why each is bounds-safe.
#
# Install with `apt install clang-tidy`. scan-build is a
# separate package (clang-tools) and not currently wired in.
tidy:
	clang-tidy siprec_sdp.c siprec_metadata.c siprec_g711.c siprec_sb.c siprec_uri.c siprec_test.c \
	    -- -Wall -Wextra -std=c11 -I.

# gcov line coverage of the FS-free units under test. Builds with
# --coverage, runs the suite (which drops .gcda next to each .gcno),
# then aggregates gcov's per-file "Lines executed" into one
# HOST_COVERAGE figure weighted by line count. Mirrors the
# freeswitch-module-testing-playbook Layer 2 coverage step.
coverage:
	rm -f $(TEST) *.gcno *.gcda *.gcov *.o
	for s in $(SOURCES:.c=); do $(CC) $(COV_CFLAGS) -c $$s.c -o $$s.o; done
	$(CC) --coverage $(SOURCES:.c=.o) -o $(TEST)
	./$(TEST) >/dev/null
	@gcov -n $(COV_UNITS) 2>/dev/null | awk '\
	  /^File/ { f=$$2; seen=1 } \
	  /Lines executed/ { \
	      if (!seen) next; \
	      split($$2,c,":"); split(c[2],d,"%"); p=d[1]+0; \
	      n=$$NF+0; ex+=p/100*n; tot+=n; seen=0; \
	      printf "  %-26s %s%% of %d lines\n", f, d[1], n } \
	  END { if (tot>0) \
	      printf "HOST_COVERAGE=%.1f%% (~%d/%d lines, units under test)\n", \
	             ex/tot*100, ex, tot }'
	@rm -f *.gcno *.gcda *.gcov *.o

all-checks: test lint analyzer asan tidy

clean:
	rm -f $(TEST) *.gcno *.gcda *.gcov *.o
	rm -rf $(FS_STUB_DIR)
